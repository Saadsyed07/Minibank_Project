@{
    ViewData["Title"] = "Deposit Money";
}

<style>
    body {
        background: #f5f7fa;
    }

    .deposit-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .deposit-card {
        width: 100%;
        max-width: 450px;
        background: white;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .deposit-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 20px;
        background: #e8f8ef;
        color: #198754;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .deposit-title {
        text-align: center;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .deposit-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 25px;
    }

    .balance-box {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        margin-bottom: 25px;
    }

    .balance-label {
        color: #6c757d;
        font-size: 14px;
    }

    .balance {
        font-size: 24px;
        font-weight: 700;
        color: #198754;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        padding: 11px;
        border-radius: 8px;
    }

    .deposit-btn {
        width: 100%;
        padding: 11px;
        border-radius: 8px;
        font-weight: 600;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        text-decoration: none;
        color: #6c757d;
    }
</style>


<div class="deposit-container">

    <div class="deposit-card">

        <div class="deposit-icon">
            <i class="bi bi-plus-circle"></i>
        </div>

        <h2 class="deposit-title">
            Deposit Money
        </h2>

        <p class="deposit-subtitle">
            Add money to your bank account
        </p>


        <!-- Current Balance -->

        <div class="balance-box">

            <div class="balance-label">
                Current Balance
            </div>

            <div class="balance">
                ₹@ViewBag.Balance.ToString("N2")
            </div>

        </div>


        <!-- Error -->
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Message
            </div>
        }


        <!-- Deposit Form -->

        <form asp-action="Deposit" method="post">

            <div class="mb-4">

                <label class="form-label">
                    Enter Amount
                </label>

                <input type="number"
                       name="amount"
                       class="form-control"
                       placeholder="Enter amount"
                       min="1"
                       step="0.01"
                       required />

            </div>


            <button type="submit"
                    class="btn btn-success deposit-btn">

                <i class="bi bi-plus-circle me-2"></i>

                Deposit Money

            </button>

        </form>


        <a asp-controller="Home"
           asp-action="Dashboard"
           class="back-link">

            ← Back to Dashboard

        </a>

    </div>

</div>